<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI 小提琴老师</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      min-height: 100vh;
      color: #e0e0e0;
      padding: 20px;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
      background: rgba(0,0,0,0.2);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }
    .header {
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .logo {
      width: 44px; height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e94560, #ff6b6b);
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
    }
    .title { font-size: 18px; font-weight: 700; color: #fff; }
    .subtitle { font-size: 12px; color: #8892b0; }
    .nav { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }
    .nav-btn {
      padding: 6px 14px;
      border-radius: 20px;
      border: none;
      background: rgba(255,255,255,0.1);
      color: #8892b0;
      font-size: 13px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.2s;
    }
    .nav-btn.active { background: #e94560; color: #fff; }
    .content { padding: 24px; min-height: 420px; }
    .tab { display: none; }
    .tab.active { display: block; }

    .theory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }
    .theory-card {
      background: rgba(255,255,255,0.05);
      border-radius: 12px;
      padding: 18px;
      cursor: pointer;
      border: 1px solid rgba(255,255,255,0.06);
      transition: all 0.2s;
    }
    .theory-card:hover { background: rgba(255,255,255,0.08); }
    .theory-detail {
      margin-top: 20px;
      background: rgba(255,255,255,0.04);
      border-radius: 12px;
      padding: 20px;
      border: 1px solid rgba(255,255,255,0.06);
      display: none;
    }
    .theory-detail.show { display: block; }
    .theory-detail h3 { color: #e94560; margin-top: 0; }
    .theory-detail ul { padding-left: 20px; margin: 8px 0; }
    .theory-detail li { margin: 4px 0; }

    .scale-btns { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .scale-btn {
      padding: 6px 16px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.05);
      color: #ccd6f6;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
    }
    .scale-btn:hover, .scale-btn.active {
      background: #e94560;
      color: #fff;
      border-color: #e94560;
    }
    .fb-info { margin-top: 12px; font-size: 13px; color: #8892b0; }

    .practice-wrap { display: flex; gap: 20px; flex-wrap: wrap; }
    .practice-col { flex: 1; min-width: 280px; }
    .card {
      background: rgba(255,255,255,0.05);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
    }
    .card-title { font-weight: 700; color: #fff; margin-bottom: 12px; }
    .timer-display {
      font-size: 42px;
      font-weight: 300;
      color: #e94560;
      font-variant-numeric: tabular-nums;
      text-align: center;
      margin: 16px 0;
    }
    .btn-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .btn {
      padding: 10px 24px;
      border-radius: 8px;
      border: none;
      background: rgba(255,255,255,0.1);
      color: #fff;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s;
    }
    .btn.primary { background: #e94560; font-weight: 600; }
    .btn:hover { opacity: 0.9; transform: translateY(-1px); }

    .metro-box {
      max-width: 400px;
      margin: 0 auto;
      text-align: center;
      background: rgba(255,255,255,0.05);
      border-radius: 16px;
      padding: 32px;
    }
    .bpm-display { font-size: 64px; font-weight: 700; color: #e94560; font-variant-numeric: tabular-nums; }
    .bpm-label { font-size: 13px; color: #8892b0; margin-bottom: 8px; }
    .bpm-controls { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 24px 0; }
    .bpm-btn {
      width: 44px; height: 44px;
      border-radius: 50%;
      border: none;
      background: rgba(255,255,255,0.1);
      color: #fff;
      font-size: 20px;
      cursor: pointer;
    }
    input[type=range] { width: 180px; accent-color: #e94560; }
    .preset-btns { display: flex; gap: 8px; justify-content: center; margin-bottom: 20px; flex-wrap: wrap; }
    .preset-btn {
      padding: 4px 12px;
      border-radius: 12px;
      border: none;
      background: rgba(255,255,255,0.06);
      color: #8892b0;
      font-size: 12px;
      cursor: pointer;
    }
    .metro-visual {
      margin-top: 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .beat-dot {
      width: 16px; height: 16px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      transition: all 0.1s;
    }
    .beat-dot.active {
      background: #e94560;
      transform: scale(1.4);
      box-shadow: 0 0 12px #e94560;
    }

    .footer {
      padding: 12px 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
      font-size: 11px;
      color: #555;
      text-align: center;
    }
  </style>
<base target="_blank">
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">🎻</div>
      <div>
        <div class="title">AI 小提琴老师</div>
        <div class="subtitle">智能陪练 · 乐理教学 · 音准分析</div>
      </div>
      <div class="nav">
        <button class="nav-btn active" onclick="switchTab('theory')">乐理</button>
        <button class="nav-btn" onclick="switchTab('fingerboard')">指板</button>
        <button class="nav-btn" onclick="switchTab('practice')">练习</button>
        <button class="nav-btn" onclick="switchTab('metronome')">节拍器</button>
      </div>
    </div>

    <div class="content">
      <div id="tab-theory" class="tab active">
        <div class="theory-grid">
          <div class="theory-card" onclick="showTheory('notes')">
            <div style="font-size:28px;margin-bottom:8px;">🎵</div>
            <div style="font-weight:700;color:#fff;margin-bottom:4px;">音符与节奏</div>
            <div style="font-size:13px;color:#8892b0;">全音符、二分音符、四分音符及对应休止符</div>
          </div>
          <div class="theory-card" onclick="showTheory('scales')">
            <div style="font-size:28px;margin-bottom:8px;">🎹</div>
            <div style="font-weight:700;color:#fff;margin-bottom:4px;">音阶与调式</div>
            <div style="font-size:13px;color:#8892b0;">大调、小调、琶音及常用调式</div>
          </div>
          <div class="theory-card" onclick="showTheory('bow')">
            <div style="font-size:28px;margin-bottom:8px;">🎼</div>
            <div style="font-weight:700;color:#fff;margin-bottom:4px;">弓法技巧</div>
            <div style="font-size:13px;color:#8892b0;">分弓、连弓、顿弓、跳弓基础教学</div>
          </div>
          <div class="theory-card" onclick="showTheory('positions')">
            <div style="font-size:28px;margin-bottom:8px;">📐</div>
            <div style="font-weight:700;color:#fff;margin-bottom:4px;">把位知识</div>
            <div style="font-size:13px;color:#8892b0;">第一把位到第五把位指法详解</div>
          </div>
        </div>
        <div id="theory-detail" class="theory-detail">
          <div id="theory-content"></div>
        </div>
      </div>

      <div id="tab-fingerboard" class="tab">
        <div class="scale-btns">
          <button class="scale-btn" onclick="setScale('G', this)">G大调</button>
          <button class="scale-btn" onclick="setScale('D', this)">D大调</button>
          <button class="scale-btn" onclick="setScale('A', this)">A大调</button>
          <button class="scale-btn" onclick="setScale('C', this)">C大调</button>
          <button class="scale-btn" onclick="setScale('none', this)">清空</button>
        </div>
        <div style="overflow-x:auto;">
          <svg id="fingerboard-svg" width="800" height="280" viewBox="0 0 800 280" style="background:#2d1b0e;border-radius:8px;">
            <rect x="20" y="20" width="760" height="240" fill="#3d2317" rx="4"/>
            <line x1="20" y1="50" x2="780" y2="50" stroke="#c9a96e" stroke-width="1.5" opacity="0.9"/>
            <line x1="20" y1="95" x2="780" y2="95" stroke="#c9a96e" stroke-width="1.5" opacity="0.9"/>
            <line x1="20" y1="140" x2="780" y2="140" stroke="#c9a96e" stroke-width="1.5" opacity="0.9"/>
            <line x1="20" y1="185" x2="780" y2="185" stroke="#c9a96e" stroke-width="1.5" opacity="0.9"/>
            <text x="8" y="54" fill="#e94560" font-size="11" font-weight="bold">G</text>
            <text x="8" y="99" fill="#e94560" font-size="11" font-weight="bold">D</text>
            <text x="8" y="144" fill="#e94560" font-size="11" font-weight="bold">A</text>
            <text x="8" y="189" fill="#e94560" font-size="11" font-weight="bold">E</text>
            <rect x="20" y="20" width="6" height="240" fill="#1a0f08"/>
            <g id="frets"></g>
            <g id="finger-dots"></g>
          </svg>
        </div>
        <div class="fb-info" id="fingerboard-info">点击上方按钮高亮显示对应调式的音位</div>
      </div>

      <div id="tab-practice" class="tab">
        <div class="practice-wrap">
          <div class="practice-col">
            <div class="card">
              <div class="card-title">🎯 当前练习</div>
              <div id="current-exercise" style="font-size:15px;color:#ccd6f6;line-height:1.6;">
                <div style="margin-bottom:8px;"><strong style="color:#e94560;">练习 1：</strong>G大调音阶（第一把位）</div>
                <div style="font-size:13px;color:#8892b0;">上行：G-A-B-C-D-E-F#-G | 下行：G-F#-E-D-C-B-A-G</div>
              </div>
              <div style="margin-top:16px;display:flex;gap:10px;">
                <button class="btn" onclick="prevExercise()">← 上一个</button>
                <button class="btn primary" onclick="nextExercise()">下一个 →</button>
              </div>
            </div>
            <div class="card">
              <div class="card-title">⏱️ 练习计时</div>
              <div class="timer-display" id="timer-display">00:00</div>
              <div class="btn-row">
                <button class="btn primary" id="timer-start" onclick="startTimer()">开始</button>
                <button class="btn" id="timer-pause" onclick="pauseTimer()" style="display:none;">暂停</button>
                <button class="btn" onclick="resetTimer()">重置</button>
              </div>
            </div>
          </div>
          <div class="practice-col">
            <div class="card" style="height:100%;">
              <div class="card-title">📊 今日练习记录</div>
              <div id="practice-log" style="font-size:13px;color:#8892b0;line-height:2;">
                <div>• G大调音阶 — 0分钟</div>
                <div>• D大调音阶 — 0分钟</div>
                <div>• 空弦长弓 — 0分钟</div>
                <div>• 揉弦练习 — 0分钟</div>
              </div>
              <div style="margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.08);">
                <div style="font-size:13px;color:#ccd6f6;">💡 <strong>AI 提示：</strong>保持左手手腕放松，手指按弦要垂直落在指板上。</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="tab-metronome" class="tab">
        <div class="metro-box">
          <div class="bpm-label">BPM</div>
          <div class="bpm-display" id="bpm-display">60</div>
          <div class="bpm-controls">
            <button class="bpm-btn" onclick="changeBpm(-5)">−</button>
            <input type="range" id="bpm-slider" min="40" max="208" value="60" oninput="setBpm(this.value)">
            <button class="bpm-btn" onclick="changeBpm(5)">+</button>
          </div>
          <div class="preset-btns">
            <button class="preset-btn" onclick="setBpm(60)">慢速 60</button>
            <button class="preset-btn" onclick="setBpm(80)">中速 80</button>
            <button class="preset-btn" onclick="setBpm(100)">中快 100</button>
            <button class="preset-btn" onclick="setBpm(120)">快速 120</button>
          </div>
          <button class="btn primary" id="metro-btn" onclick="toggleMetronome()" style="width:100%;padding:14px;font-size:16px;">▶ 启动节拍器</button>
          <div class="metro-visual" id="metro-visual">
            <div class="beat-dot"></div>
            <div class="beat-dot"></div>
            <div class="beat-dot"></div>
            <div class="beat-dot"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer">AI Violin Teacher · 保持热爱，持续练习</div>
  </div>

  <script>
    function switchTab(tab) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-'+tab).classList.add('active');
      event.target.classList.add('active');
    }

    const theoryData = {
      notes: \`<h3>🎵 音符与节奏</h3>
        <p><strong>基本音符时值：</strong></p>
        <ul>
          <li><strong>全音符</strong> — 4拍，空心符头，无符干</li>
          <li><strong>二分音符</strong> — 2拍，空心符头，有符干</li>
          <li><strong>四分音符</strong> — 1拍，实心符头，有符干</li>
          <li><strong>八分音符</strong> — 1/2拍，带一条符尾</li>
          <li><strong>十六分音符</strong> — 1/4拍，带两条符尾</li>
        </ul>
        <p><strong>小提琴特殊节奏：</strong>注意连弓（一弓多音）与分弓（一弓一音）对节奏表达的影响。</p>\`,
      scales: \`<h3>🎹 音阶与调式</h3>
        <p><strong>大调音阶结构：</strong>全-全-半-全-全-全-半</p>
        <p><strong>小提琴常用调式：</strong></p>
        <ul>
          <li><strong>G大调</strong>：1个升号（F#），最适合初学者</li>
          <li><strong>D大调</strong>：2个升号（F#, C#）</li>
          <li><strong>A大调</strong>：3个升号（F#, C#, G#）</li>
          <li><strong>C大调</strong>：无升降号，但G弦起始需换把</li>
        </ul>
        <p><strong>琶音练习：</strong>每调练习主和弦（1-3-5-8-5-3-1）。</p>\`,
      bow: \`<h3>🎼 弓法技巧</h3>
        <ul>
          <li><strong>分弓 (Détaché)</strong>：每弓一个音，弓速均匀</li>
          <li><strong>连弓 (Legato)</strong>：一弓多音，左右手协调</li>
          <li><strong>顿弓 (Martelé)</strong>：开头有轻微重音</li>
          <li><strong>跳弓 (Spiccato)</strong>：弓毛自然弹跳</li>
        </ul>
        <p><strong>运弓要点：</strong>右臂放松，以肩关节为轴，弓子走直。靠近琴马音色更亮，靠近指板音色更柔。</p>\`,
      positions: \`<h3>📐 把位知识</h3>
        <p><strong>第一把位：</strong>左手不移动的基础位置。</p>
        <ul>
          <li>G弦：G(空)-A(1)-B(2)-C(3)-D(4)</li>
          <li>D弦：D(空)-E(1)-F#(2)-G(3)-A(4)</li>
          <li>A弦：A(空)-B(1)-C#(2)-D(3)-E(4)</li>
          <li>E弦：E(空)-F#(1)-G#(2)-A(3)-B(4)</li>
        </ul>
        <p><strong>换把原则：</strong>先动肘部带动整体，耳朵监听音准。第三把位食指位置与下一弦空弦同音。</p>\`
    };
    function showTheory(key) {
      document.getElementById('theory-detail').classList.add('show');
      document.getElementById('theory-content').innerHTML = theoryData[key];
    }

    const fretPositions = [0,45,88,128,165,200,233,264,293,320,345,369,392,413,433,452,470,487,503,518,532,545,558,570,581];
    const stringNotes = {
      'G': ['G3','G#3','A3','A#3','B3','C4','C#4','D4','D#4','E4','F4','F#4','G4','G#4','A4','A#4','B4','C5','C#5','D5','D#5','E5','F5','F#5','G5'],
      'D': ['D4','D#4','E4','F4','F#4','G4','G#4','A4','A#4','B4','C5','C#5','D5','D#5','E5','F5','F#5','G5','G#5','A5','A#5','B5','C6','C#6','D6'],
      'A': ['A3','A#3','B3','C4','C#4','D4','D#4','E4','F4','F#4','G4','G#4','A4','A#4','B4','C5','C#5','D5','D#5','E5','F5','F#5','G5','G#5','A5'],
      'E': ['E4','F4','F#4','G4','G#4','A4','A#4','B4','C5','C#5','D5','D#5','E5','F5','F#5','G5','G#5','A5','A#5','B5','C6','C#6','D6','D#6','E6']
    };
    const scaleNotes = {
      'G': ['G','A','B','C','D','E','F#'],
      'D': ['D','E','F#','G','A','B','C#'],
      'A': ['A','B','C#','D','E','F#','G#'],
      'C': ['C','D','E','F','G','A','B']
    };
    let currentScale = 'none';

    function drawFingerboard() {
      const fretsG = document.getElementById('frets');
      const dotsG = document.getElementById('finger-dots');
      fretsG.innerHTML = '';
      dotsG.innerHTML = '';
      fretPositions.forEach((x,i) => {
        if(i===0) return;
        const line = document.createElementNS('http://www.w3.org/2000/svg','line');
        line.setAttribute('x1', 26+x); line.setAttribute('y1', 20);
        line.setAttribute('x2', 26+x); line.setAttribute('y2', 260);
        line.setAttribute('stroke','#8b7355'); line.setAttribute('stroke-width','1');
        fretsG.appendChild(line);
        if([3,5,7,9,12,15,17,19].includes(i)) {
          const num = document.createElementNS('http://www.w3.org/2000/svg','text');
          num.setAttribute('x', 26+x-8); num.setAttribute('y', 275);
          num.setAttribute('fill','#8b7355'); num.setAttribute('font-size','10');
          num.textContent = i; fretsG.appendChild(num);
        }
      });
      if(currentScale !== 'none') {
        const scale = scaleNotes[currentScale];
        const strings = ['G','D','A','E'];
        const yPos = [50,95,140,185];
        strings.forEach((str,si) => {
          stringNotes[str].forEach((note,fi) => {
            const noteName = note.replace(/\d/,'');
            if(scale.includes(noteName)) {
              const x = fi===0 ? 23 : 26 + fretPositions[fi] - (fretPositions[fi]-fretPositions[fi-1])/2;
              const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
              c.setAttribute('cx',x); c.setAttribute('cy',yPos[si]);
              c.setAttribute('r', fi===0?7:9); c.setAttribute('fill','#e94560'); c.setAttribute('opacity','0.85');
              dotsG.appendChild(c);
              const t = document.createElementNS('http://www.w3.org/2000/svg','text');
              t.setAttribute('x',x); t.setAttribute('y',yPos[si]+4);
              t.setAttribute('text-anchor','middle'); t.setAttribute('fill','#fff');
              t.setAttribute('font-size','9'); t.setAttribute('font-weight','bold');
              t.textContent = noteName; dotsG.appendChild(t);
            }
          });
        });
        document.getElementById('fingerboard-info').innerHTML = \`<span style="color:#e94560;">●</span> 高亮显示 <strong>${currentScale}大调</strong> 音阶音位\`;
      }
    }
    function setScale(scale, btn) {
      currentScale = scale;
      document.querySelectorAll('.scale-btn').forEach(b => b.classList.remove('active'));
      if(btn) btn.classList.add('active');
      drawFingerboard();
    }
    drawFingerboard();

    const exercises = [
      {name:'G大调音阶（第一把位）', desc:'上行：G-A-B-C-D-E-F#-G | 下行：G-F#-E-D-C-B-A-G'},
      {name:'D大调音阶（第一把位）', desc:'上行：D-E-F#-G-A-B-C#-D | 下行：D-C#-B-A-G-F#-E-D'},
      {name:'A大调音阶（第一把位）', desc:'上行：A-B-C#-D-E-F#-G#-A | 下行：A-G#-F#-E-D-C#-B-A'},
      {name:'空弦长弓练习', desc:'每根空弦拉满全弓，保持弓速均匀、音色平稳。注意右臂放松。'},
      {name:'G大调琶音', desc:'G-B-D-G-D-B-G，一弓两音或四音，练习把位稳定性。'},
      {name:'揉弦基础', desc:'左手按稳音符后，手腕做前后滚动动作，幅度由小到大。'},
      {name:'换弦练习', desc:'G-D-A-E 四根弦快速切换，保持右手平面不变，仅用小臂带动。'},
      {name:'C大调音阶', desc:'注意G弦2指和3指之间的半音关系，音准是关键。'}
    ];
    let exerciseIndex = 0;
    function updateExercise() {
      const ex = exercises[exerciseIndex];
      document.getElementById('current-exercise').innerHTML = \`
        <div style="margin-bottom:8px;"><strong style="color:#e94560;">练习 ${exerciseIndex+1}：</strong>${ex.name}</div>
        <div style="font-size:13px;color:#8892b0;">${ex.desc}</div>\`;
    }
    function nextExercise() { exerciseIndex = (exerciseIndex+1)%exercises.length; updateExercise(); }
    function prevExercise() { exerciseIndex = (exerciseIndex-1+exercises.length)%exercises.length; updateExercise(); }

    let timerInterval = null, timerSeconds = 0, timerRunning = false;
    function formatTime(s) {
      const m = Math.floor(s/60).toString().padStart(2,'0');
      const sec = (s%60).toString().padStart(2,'0');
      return m+':'+sec;
    }
    function startTimer() {
      if(timerRunning) return;
      timerRunning = true;
      document.getElementById('timer-start').style.display = 'none';
      document.getElementById('timer-pause').style.display = 'inline-block';
      timerInterval = setInterval(() => {
        timerSeconds++;
        document.getElementById('timer-display').textContent = formatTime(timerSeconds);
      }, 1000);
    }
    function pauseTimer() {
      timerRunning = false;
      clearInterval(timerInterval);
      document.getElementById('timer-start').style.display = 'inline-block';
      document.getElementById('timer-pause').style.display = 'none';
    }
    function resetTimer() { pauseTimer(); timerSeconds = 0; document.getElementById('timer-display').textContent = '00:00'; }

    let bpm = 60, metroInterval = null, metroRunning = false, beatIndex = 0;
    function setBpm(val) {
      bpm = parseInt(val);
      document.getElementById('bpm-display').textContent = bpm;
      document.getElementById('bpm-slider').value = bpm;
      if(metroRunning) { clearInterval(metroInterval); startMetroInterval(); }
    }
    function changeBpm(delta) { setBpm(Math.max(40, Math.min(208, bpm+delta))); }
    function startMetroInterval() {
      const interval = 60000/bpm;
      metroInterval = setInterval(() => {
        beatIndex = (beatIndex+1)%4;
        document.querySelectorAll('.beat-dot').forEach((d,i) => {
          d.classList.toggle('active', i===beatIndex);
        });
      }, interval);
    }
    function toggleMetronome() {
      const btn = document.getElementById('metro-btn');
      if(metroRunning) {
        metroRunning = false; clearInterval(metroInterval);
        btn.textContent = '▶ 启动节拍器'; btn.style.background = '#e94560';
        document.querySelectorAll('.beat-dot').forEach(d => d.classList.remove('active'));
      } else {
        metroRunning = true; beatIndex = -1;
        btn.textContent = '⏹ 停止节拍器'; btn.style.background = '#ff6b6b';
        startMetroInterval();
      }
    }
  </script>
</body>
</html>
