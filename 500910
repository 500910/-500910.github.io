<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Violin Teacher - 智能小提琴老師</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vexflow@4.2.2/build/cjs/vexflow.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Noto Sans TC', sans-serif; }
        body { background: #0f172a; color: #e2e8f0; }
        .glass {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.08);
        }
        .btn-primary {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(99,102,241,0.4);
        }
        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            transition: all 0.3s ease;
        }
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(239,68,68,0.4);
        }
        .btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            transition: all 0.3s ease;
        }
        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(16,185,129,0.4);
        }
        .recording-pulse {
            animation: pulse-red 1.5s infinite;
        }
        @keyframes pulse-red {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.7); }
            50% { box-shadow: 0 0 0 15px rgba(239,68,68,0); }
        }
        .pitch-bar {
            transition: height 0.1s ease, background-color 0.2s ease;
        }
        .score-ring {
            transition: stroke-dashoffset 1s ease-in-out;
        }
        .tab-active {
            border-bottom: 2px solid #6366f1;
            color: #818cf8;
        }
        .tab-inactive {
            border-bottom: 2px solid transparent;
            color: #94a3b8;
        }
        .tab-inactive:hover { color: #cbd5e1; }
        #pitchCanvas {
            width: 100%;
            height: 120px;
            border-radius: 8px;
            background: #1e293b;
        }
        .note-cell {
            transition: all 0.3s ease;
        }
        .note-cell.correct { background: rgba(16,185,129,0.2); border-color: #10b981; }
        .note-cell.wrong { background: rgba(239,68,68,0.2); border-color: #ef4444; }
        .note-cell.current { box-shadow: 0 0 0 2px #6366f1; }
    </style>
</head>
<body class="min-h-screen">

    <!-- Header -->
    <header class="glass sticky top-0 z-50 px-6 py-4">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg">🎻</div>
                <div>
                    <h1 class="text-xl font-bold text-white">AI Violin Teacher</h1>
                    <p class="text-xs text-slate-400">智能小提琴老師</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div id="connectionStatus" class="flex items-center gap-2 text-xs px-3 py-1.5 rounded-full bg-slate-800 text-slate-400">
                    <span class="w-2 h-2 rounded-full bg-slate-500" id="statusDot"></span>
                    <span id="statusText">未連接</span>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-6 space-y-6">

        <!-- Tabs -->
        <div class="flex gap-6 border-b border-slate-700 pb-1">
            <button onclick="switchTab('practice')" id="tab-practice" class="tab-active pb-3 text-sm font-medium transition-colors">🎵 練習模式</button>
            <button onclick="switchTab('record')" id="tab-record" class="tab-inactive pb-3 text-sm font-medium transition-colors">📹 錄影回放</button>
            <button onclick="switchTab('history')" id="tab-history" class="tab-inactive pb-3 text-sm font-medium transition-colors">📊 練習紀錄</button>
        </div>

        <!-- Practice Mode -->
        <div id="panel-practice" class="space-y-6">
            
            <!-- Top Row: Video + Sheet Music -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                
                <!-- Video Panel -->
                <div class="glass rounded-2xl p-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-white flex items-center gap-2">📹 錄影預覽</h2>
                        <span id="recordingTimer" class="text-2xl font-mono font-bold text-red-400 hidden">00:00</span>
                    </div>
                    <div class="relative rounded-xl overflow-hidden bg-black aspect-video">
                        <video id="videoPreview" class="w-full h-full object-cover" autoplay muted playsinline></video>
                        <div id="recordingIndicator" class="absolute top-4 right-4 w-3 h-3 rounded-full bg-red-500 hidden recording-pulse"></div>
                        <div id="placeholderOverlay" class="absolute inset-0 flex items-center justify-center text-slate-500">
                            <div class="text-center">
                                <div class="text-4xl mb-2">🎻</div>
                                <p class="text-sm">點擊「開始錄影」啟動攝影機</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex gap-3">
                        <button id="btnStartRecord" onclick="startRecording()" class="btn-primary flex-1 py-3 rounded-xl font-medium text-white text-sm">
                            🔴 開始錄影
                        </button>
                        <button id="btnStopRecord" onclick="stopRecording()" class="btn-danger flex-1 py-3 rounded-xl font-medium text-white text-sm hidden" disabled>
                            ⏹ 停止錄影
                        </button>
                        <button id="btnPlayBack" onclick="playBack()" class="btn-success flex-1 py-3 rounded-xl font-medium text-white text-sm hidden" disabled>
                            ▶ 回放
                        </button>
                        <button id="btnDownload" onclick="downloadVideo()" class="glass flex-1 py-3 rounded-xl font-medium text-slate-300 text-sm hidden hover:text-white hover:bg-slate-700 transition-all">
                            💾 下載
                        </button>
                    </div>
                </div>

                <!-- Sheet Music Panel -->
                <div class="glass rounded-2xl p-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-white flex items-center gap-2">🎼 樂譜</h2>
                        <select id="pieceSelect" onchange="loadPiece(this.value)" class="bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500">
                            <option value="twinkle">小星星變奏曲 (Twinkle Twinkle)</option>
                            <option value="ode">歡樂頌 (Ode to Joy)</option>
                            <option value="scaleG">G大調音階</option>
                            <option value="scaleD">D大調音階</option>
                            <option value="scaleA">A大調音階</option>
                        </select>
                    </div>
                    <div id="sheetMusic" class="rounded-xl overflow-hidden bg-white" style="min-height: 200px;"></div>
                    <div class="flex items-center justify-between text-xs text-slate-400">
                        <span>🎯 目標曲目：<span id="targetPieceName" class="text-indigo-400 font-medium">小星星變奏曲</span></span>
                        <span id="currentNoteDisplay" class="text-lg font-mono text-emerald-400">--</span>
                    </div>
                </div>
            </div>

            <!-- Audio Analysis Panel -->
            <div class="glass rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between flex-wrap gap-2">
                    <h2 class="text-lg font-semibold text-white flex items-center gap-2">📊 即時音準分析</h2>
                    <div class="flex items-center gap-3">
                        <button id="btnStartAudio" onclick="toggleAudioAnalysis()" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-sm text-white transition-colors">
                            🔊 開始音訊分析
                        </button>
                        <span id="detectedPitch" class="text-2xl font-mono font-bold text-indigo-400">-- Hz</span>
                        <span id="detectedNote" class="text-xl font-bold text-emerald-400">--</span>
                    </div>
                </div>
                <canvas id="pitchCanvas"></canvas>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <div class="bg-slate-800/50 rounded-xl p-3 text-center">
                        <div class="text-xs text-slate-400 mb-1">音量</div>
                        <div class="text-lg font-bold text-amber-400" id="volumeMeter">0%</div>
                        <div class="w-full bg-slate-700 rounded-full h-1.5 mt-2">
                            <div id="volumeBar" class="bg-amber-400 h-1.5 rounded-full transition-all" style="width: 0%"></div>
                        </div>
                    </div>
                    <div class="bg-slate-800/50 rounded-xl p-3 text-center">
                        <div class="text-xs text-slate-400 mb-1">音準偏差</div>
                        <div class="text-lg font-bold text-rose-400" id="pitchDeviation">--</div>
                        <div class="text-xs text-slate-500">cent</div>
                    </div>
                    <div class="bg-slate-800/50 rounded-xl p-3 text-center">
                        <div class="text-xs text-slate-400 mb-1">穩定度</div>
                        <div class="text-lg font-bold text-cyan-400" id="stability">--</div>
                        <div class="text-xs text-slate-500">0-100</div>
                    </div>
                    <div class="bg-slate-800/50 rounded-xl p-3 text-center">
                        <div class="text-xs text-slate-400 mb-1">演奏時長</div>
                        <div class="text-lg font-bold text-purple-400" id="playDuration">0s</div>
                        <div class="text-xs text-slate-500">秒</div>
                    </div>
                </div>
            </div>

            <!-- AI Score Panel -->
            <div class="glass rounded-2xl p-5 space-y-4">
                <h2 class="text-lg font-semibold text-white flex items-center gap-2">🤖 AI 評分</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Overall Score -->
                    <div class="flex items-center gap-6">
                        <div class="relative w-32 h-32 flex-shrink-0">
                            <svg class="w-32 h-32 transform -rotate-90">
                                <circle cx="64" cy="64" r="56" stroke="#1e293b" stroke-width="10" fill="none"/>
                                <circle id="scoreRing" cx="64" cy="64" r="56" stroke="url(#scoreGradient)" stroke-width="10" fill="none"
                                    stroke-dasharray="351.86" stroke-dashoffset="351.86" stroke-linecap="round" class="score-ring"/>
                                <defs>
                                    <linearGradient id="scoreGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#6366f1"/>
                                        <stop offset="100%" stop-color="#8b5cf6"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span id="overallScore" class="text-3xl font-bold text-white">--</span>
                            </div>
                        </div>
                        <div class="space-y-2 flex-1">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">音準 (Pitch)</span>
                                <span id="scorePitch" class="font-bold text-indigo-400">--</span>
                            </div>
                            <div class="w-full bg-slate-700 rounded-full h-2">
                                <div id="barPitch" class="bg-indigo-500 h-2 rounded-full transition-all" style="width: 0%"></div>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">節奏 (Rhythm)</span>
                                <span id="scoreRhythm" class="font-bold text-emerald-400">--</span>
                            </div>
                            <div class="w-full bg-slate-700 rounded-full h-2">
                                <div id="barRhythm" class="bg-emerald-500 h-2 rounded-full transition-all" style="width: 0%"></div>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">音色 (Tone)</span>
                                <span id="scoreTone" class="font-bold text-amber-400">--</span>
                            </div>
                            <div class="w-full bg-slate-700 rounded-full h-2">
                                <div id="barTone" class="bg-amber-500 h-2 rounded-full transition-all" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                    <!-- AI Feedback -->
                    <div class="bg-slate-800/50 rounded-xl p-4 space-y-3">
                        <h3 class="text-sm font-semibold text-slate-300">💡 AI 建議</h3>
                        <div id="aiFeedback" class="space-y-2 text-sm text-slate-400">
                            <p class="flex items-start gap-2"><span class="text-indigo-400 mt-0.5">▸</span> 開始演奏以獲取 AI 分析...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recordings Tab -->
        <div id="panel-record" class="hidden space-y-6">
            <div class="glass rounded-2xl p-5">
                <h2 class="text-lg font-semibold text-white mb-4">📹 錄影回放</h2>
                <div class="rounded-xl overflow-hidden bg-black aspect-video max-w-3xl mx-auto">
                    <video id="playbackVideo" class="w-full h-full" controls></video>
                </div>
                <p class="text-center text-slate-500 text-sm mt-4">選擇下方錄影檔案進行回放</p>
            </div>
            <div class="glass rounded-2xl p-5">
                <h3 class="text-sm font-semibold text-slate-300 mb-3">錄影檔案</h3>
                <div id="recordingsList" class="space-y-2">
                    <p class="text-slate-500 text-sm text-center py-8">尚無錄影檔案</p>
                </div>
            </div>
        </div>

        <!-- History Tab -->
        <div id="panel-history" class="hidden space-y-6">
            <div class="glass rounded-2xl p-5">
                <h2 class="text-lg font-semibold text-white mb-4">📊 練習紀錄</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-700 text-slate-400">
                                <th class="text-left py-3 px-2">日期</th>
                                <th class="text-left py-3 px-2">曲目</th>
                                <th class="text-center py-3 px-2">時長</th>
                                <th class="text-center py-3 px-2">音準</th>
                                <th class="text-center py-3 px-2">總分</th>
                                <th class="text-center py-3 px-2">操作</th>
                            </tr>
                        </thead>
                        <tbody id="historyTable" class="text-slate-300">
                            <!-- Dynamic rows -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="glass rounded-xl p-4 text-center">
                    <div class="text-3xl font-bold text-indigo-400" id="totalSessions">0</div>
                    <div class="text-xs text-slate-400 mt-1">總練習次數</div>
                </div>
                <div class="glass rounded-xl p-4 text-center">
                    <div class="text-3xl font-bold text-emerald-400" id="avgScore">--</div>
                    <div class="text-xs text-slate-400 mt-1">平均得分</div>
                </div>
                <div class="glass rounded-xl p-4 text-center">
                    <div class="text-3xl font-bold text-amber-400" id="totalTime">0</div>
                    <div class="text-xs text-slate-400 mt-1">總練習時長 (分)</div>
                </div>
            </div>
        </div>

    </main>

    <script>
    // ==================== GLOBAL STATE ====================
    let mediaRecorder = null;
    let recordedChunks = [];
    let stream = null;
    let audioContext = null;
    let analyser = null;
    let audioStream = null;
    let isRecording = false;
    let isAudioAnalyzing = false;
    let recordingStartTime = 0;
    let recordingTimerInterval = null;
    let audioAnalysisInterval = null;
    let playStartTime = 0;
    let pitchHistory = [];
    let recordings = JSON.parse(localStorage.getItem('violin_recordings') || '[]');
    let sessionHistory = JSON.parse(localStorage.getItem('violin_history') || '[]');
    let currentPiece = 'twinkle';
    let targetNotes = [];
    let detectedNotes = [];
    let canvasCtx = null;
    let animationId = null;

    // ==================== PIECE DATA ====================
    const PIECES = {
        twinkle: {
            name: '小星星變奏曲',
            notes: ['C4','C4','G4','G4','A4','A4','G4','F4','F4','E4','E4','D4','D4','C4'],
            bpm: 100
        },
        ode: {
            name: '歡樂頌',
            notes: ['E4','E4','F4','G4','G4','F4','E4','D4','C4','C4','D4','E4','E4','D4','D4'],
            bpm: 120
        },
        scaleG: {
            name: 'G大調音階',
            notes: ['G3','A3','B3','C4','D4','E4','F#4','G4','G4','F#4','E4','D4','C4','B3','A3','G3'],
            bpm: 80
        },
        scaleD: {
            name: 'D大調音階',
            notes: ['D3','E3','F#3','G3','A3','B3','C#4','D4','D4','C#4','B3','A3','G3','F#3','E3','D3'],
            bpm: 80
        },
        scaleA: {
            name: 'A大調音階',
            notes: ['A3','B3','C#4','D4','E4','F#4','G#4','A4','A4','G#4','F#4','E4','D4','C#4','B3','A3'],
            bpm: 80
        }
    };

    const NOTE_FREQS = {
        'C3':130.81,'C#3':138.59,'D3':146.83,'D#3':155.56,'E3':164.81,'F3':174.61,'F#3':185.00,'G3':196.00,'G#3':207.65,'A3':220.00,'A#3':233.08,'B3':246.94,
        'C4':261.63,'C#4':277.18,'D4':293.66,'D#4':311.13,'E4':329.63,'F4':349.23,'F#4':369.99,'G4':392.00,'G#4':415.30,'A4':440.00,'A#4':466.16,'B4':493.88,
        'C5':523.25,'C#5':554.37,'D5':587.33,'D#5':622.25,'E5':659.25,'F5':698.46,'F#5':739.99,'G5':783.99,'G#5':830.61,'A5':880.00,'A#5':932.33,'B5':987.77
    };

    // ==================== INIT ====================
    document.addEventListener('DOMContentLoaded', () => {
        loadPiece('twinkle');
        renderHistory();
        renderRecordingsList();
        initPitchCanvas();
    });

    function switchTab(tab) {
        ['practice','record','history'].forEach(t => {
            document.getElementById('panel-' + t).classList.add('hidden');
            document.getElementById('tab-' + t).classList.remove('tab-active');
            document.getElementById('tab-' + t).classList.add('tab-inactive');
        });
        document.getElementById('panel-' + tab).classList.remove('hidden');
        document.getElementById('tab-' + tab).classList.add('tab-active');
        document.getElementById('tab-' + tab).classList.remove('tab-inactive');
    }

    // ==================== VIDEO RECORDING ====================
    async function startRecording() {
        try {
            stream = await navigator.mediaDevices.getUserMedia({
                audio: true,
                video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } }
            });
            const video = document.getElementById('videoPreview');
            video.srcObject = stream;
            video.play();
            document.getElementById('placeholderOverlay').classList.add('hidden');

            mediaRecorder = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp9,opus' });
            recordedChunks = [];
            mediaRecorder.ondataavailable = e => { if (e.data.size > 0) recordedChunks.push(e.data); };
            mediaRecorder.onstop = onRecordingStop;
            mediaRecorder.start(100);

            isRecording = true;
            recordingStartTime = Date.now();
            recordingTimerInterval = setInterval(updateRecordingTimer, 1000);

            document.getElementById('btnStartRecord').classList.add('hidden');
            document.getElementById('btnStopRecord').classList.remove('hidden');
            document.getElementById('btnStopRecord').disabled = false;
            document.getElementById('recordingIndicator').classList.remove('hidden');
            document.getElementById('recordingTimer').classList.remove('hidden');

            updateStatus('recording');

            // Auto start audio analysis
            if (!isAudioAnalyzing) toggleAudioAnalysis();

        } catch (e) {
            alert('無法存取攝影機：' + e.message);
        }
    }

    function stopRecording() {
        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            mediaRecorder.stop();
        }
        if (stream) {
            stream.getTracks().forEach(t => t.stop());
        }
        isRecording = false;
       
