<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>AI 小提琴老师</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0d1117; color: #e6edf3;
      min-height: 100vh; display: flex; flex-direction: column; align-items: center;
      padding: 16px; overflow-x: hidden;
    }
    .header { text-align: center; margin-bottom: 14px; }
    .header h1 {
      font-size: 26px; font-weight: 800;
      background: linear-gradient(135deg, #a3e635 0%, #4ade80 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .header p { color: #8b949e; font-size: 13px; margin-top: 2px; }

    /* Camera */
    .camera-wrap {
      width: 100%; max-width: 400px; aspect-ratio: 4/3;
      background: #000; border-radius: 16px; overflow: hidden;
      position: relative; border: 1px solid #30363d; margin-bottom: 14px;
    }
    .camera-wrap video { width: 100%; height: 100%; object-fit: cover; display: none; }
    .cam-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      flex-direction: column; color: #484f58; cursor: pointer;
    }
    .rec-dot {
      position: absolute; top: 10px; right: 10px;
      width: 10px; height: 10px; background: #f85149; border-radius: 50%;
      display: none; animation: pulse 1.2s infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

    /* Pitch Meter */
    .meter-card {
      width: 100%; max-width: 400px; background: #161b22;
      border-radius: 16px; padding: 18px; border: 1px solid #30363d;
      margin-bottom: 14px; position: relative;
    }
    .meter-scale {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 6px; padding: 0 8px;
    }
    .meter-scale span { font-size: 11px; font-weight: 600; }
    .meter-scale .neg { color: #f85149; }
    .meter-scale .pos { color: #f85149; }
    .meter-scale .unit { color: #6e7681; }

    .meter-track {
      position: relative; height: 160px; display: flex;
      justify-content: center; align-items: flex-end;
    }
    .meter-track .rail {
      position: absolute; width: 4px; height: 100%;
      background: #21262d; border-radius: 2px;
    }
    .meter-ticks {
      position: absolute; width: 100%; height: 100%;
      display: flex; flex-direction: column; justify-content: space-between;
      align-items: center; pointer-events: none;
    }
    .tick { width: 14px; height: 1px; background: #30363d; }
    .tick.major { width: 22px; height: 2px; }
    .tick.major.top { background: #f85149; opacity: .5; }
    .tick.major.mid { background: #3fb950; opacity: .6; }
    .tick.major.bot { background: #f85149; opacity: .5; }

    .target-zone {
      position: absolute; width: 36px; height: 36px;
      background: rgba(63,185,80,0.08); border-radius: 50%;
      border: 1px solid rgba(63,185,80,0.25);
      bottom: 50%; transform: translateY(50%);
    }
    .needle {
      position: absolute; bottom: 50%; transform: translateY(50%);
      width: 24px; height: 24px; border-radius: 50%;
      border: 3px solid #0d1117; z-index: 3;
      transition: bottom .12s ease-out, background .15s, box-shadow .15s;
    }

    .note-info { text-align: center; margin-top: 10px; }
    .note-name { font-size: 30px; font-weight: 800; min-height: 38px; }
    .note-freq { font-size: 12px; color: #8b949e; margin-top: 2px; }
    .cents-badge {
      position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
      font-size: 13px; font-weight: 700; min-width: 36px; text-align: center;
    }

    /* String selector */
    .strings {
      width: 100%; max-width: 400px;
      display: flex; gap: 8px; margin-bottom: 14px;
    }
    .str-btn {
      flex: 1; padding: 10px 0; border-radius: 10px; border: 1px solid #30363d;
      background: #161b22; color: #8b949e; font-size: 13px; font-weight: 600;
      cursor: pointer; transition: all .2s;
    }
    .str-btn.active {
      background: rgba(163,230,53,0.15); color: #a3e635;
      border-color: rgba(163,230,53,0.4);
    }

    /* Controls */
    .controls {
      width: 100%; max-width: 400px;
      display: flex; gap: 10px; margin-bottom: 14px;
    }
    .metro-btn {
      flex: 1; background: rgba(163,230,53,0.12); color: #a3e635;
      border: 1px solid rgba(163,230,53,0.3); padding: 12px;
      border-radius: 12px; font-size: 14px; font-weight: 600;
      cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 5px;
    }
    .metro-btn.on { background: rgba(163,230,53,0.35); }
    .tempo-wrap {
      flex: 1.6; display: flex; align-items: center; gap: 8px;
      background: #161b22; padding: 8px 14px; border-radius: 12px;
      border: 1px solid #30363d;
    }
    .tempo-wrap span { font-size: 12px; color: #8b949e; white-space: nowrap; }
    .tempo-wrap input { flex: 1; accent-color: #58a6ff; }
    .tempo-val { font-size: 12px; color: #58a6ff; font-weight: 700; min-width: 28px; text-align: right; }

    /* Bottom area */
    .bottom {
      width: 100%; max-width: 400px;
      display: flex; justify-content: space-between; align-items: flex-end;
    }
    .status { color: #6e7681; font-size: 12px; }
    .pip {
      width: 90px; height: 120px; background: #000;
      border-radius: 12px; overflow: hidden; border: 2px solid #30363d;
      position: relative;
    }
    .pip video { width: 100%; height: 100%; object-fit: cover; display: none; }
    .pip .pip-ph {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      color: #484f58;
    }
    .pip .rec-toggle {
      position: absolute; bottom: 4px; right: 4px;
      width: 18px; height: 18px; background: #f85149; border-radius: 50%;
      display: flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .pip .rec-toggle div { width: 7px; height: 7px; background: #fff; border-radius: 2px; }

    /* Start overlay */
    .start-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.7);
      display: flex; align-items: center; justify-content: center; z-index: 200;
      backdrop-filter: blur(4px);
    }
    .start-btn {
      background: linear-gradient(135deg, #3fb950, #2ea043);
      color: #fff; border: none; padding: 16px 40px;
      border-radius: 30px; font-size: 17px; font-weight: 700;
      cursor: pointer; box-shadow: 0 6px 24px rgba(63,185,80,0.35);
    }
    .start-btn:hover { transform: scale(1.03); }
    .hidden { display: none !important; }

    /* Volume bar */
    .vol-bar {
      position: absolute; left: 10px; top: 20px; bottom: 20px; width: 4px;
      background: #21262d; border-radius: 2px; overflow: hidden;
    }
    .vol-fill {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: #3fb950; border-radius: 2px;
      transition: height .1s;
    }
  </style>
</head>
<body>

  <div class="header">
    <h1>AI 小提琴老师</h1>
    <p>初级版 · 音准检测 & 录像回放</p>
  </div>

  <!-- Camera -->
  <div class="camera-wrap" id="camWrap">
    <video id="mainVideo" autoplay muted playsinline></video>
    <div class="cam-placeholder" id="camPh">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
        <circle cx="12" cy="13" r="4"/>
      </svg>
      <p style="margin-top:6px;font-size:12px">点击开启摄像头</p>
    </div>
    <div class="rec-dot" id="recDot"></div>
  </div>

  <!-- Pitch Meter -->
  <div class="meter-card">
    <div class="meter-scale">
      <span class="neg">-40</span>
      <span class="unit">音分</span>
      <span class="pos">+40</span>
    </div>
    <div class="meter-track">
      <div class="rail"></div>
      <div class="meter-ticks">
        <div class="tick major top"></div>
        <div class="tick"></div><div class="tick"></div><div class="tick"></div>
        <div class="tick major mid"></div>
        <div class="tick"></div><div class="tick"></div><div class="tick"></div>
        <div class="tick major bot"></div>
      </div>
      <div class="target-zone"></div>
      <div class="needle" id="needle" style="background:#3fb950;box-shadow:0 0 12px rgba(63,185,80,0.4)"></div>
      <div class="vol-bar"><div class="vol-fill" id="volFill" style="height:0%"></div></div>
    </div>
    <div class="note-info">
      <div class="note-name" id="noteName">--</div>
      <div class="note-freq" id="noteFreq">等待演奏...</div>
    </div>
    <div class="cents-badge" id="centsBadge"></div>
  </div>

  <!-- String Selector -->
  <div class="strings">
    <button class="str-btn" data-freq="196.00" data-note="G3">G3 空弦</button>
    <button class="str-btn" data-freq="293.66" data-note="D4">D4 空弦</button>
    <button class="str-btn active" data-freq="440.00" data-note="A4">A4 空弦</button>
    <button class="str-btn" data-freq="659.25" data-note="E5">E5 空弦</button>
    <button class="str-btn" data-freq="0" data-note="自由">自由</button>
  </div>

  <!-- Controls -->
  <div class="controls">
    <button class="metro-btn" id="metroBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
      </svg>
      节拍器
    </button>
    <div class="tempo-wrap">
      <span>速度</span>
      <input type="range" id="tempoSlider" min="40" max="208" value="100">
      <span class="tempo-val" id="tempoVal">100</span>
    </div>
  </div>

  <!-- Bottom -->
  <div class="bottom">
    <div class="status" id="status">太安静了 · 请拉响琴</div>
    <div class="pip">
      <video id="pipVideo" autoplay muted playsinline></video>
      <div class="pip-ph" id="pipPh">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
      </div>
      <div class="rec-toggle" id="recToggle"><div></div></div>
    </div>
  </div>

  <!-- Start Overlay -->
  <div class="start-overlay" id="startOverlay">
    <button class="start-btn" id="startBtn">🎻 开始练习</button>
  </div>

<script>
/* ========== AUDIO ENGINE ========== */
let audioCtx = null, analyser = null, micStream = null;
let rafId = null, isRunning = false;
let targetFreq = 440; // 当前目标频率
let targetNote = 'A4';

const NOTE_NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];

function freqToNote(freq) {
  const A4 = 440;
  const st = 12 * Math.log2(freq / A4);
  const idx = Math.round(st);
  const cents = Math.round((st - idx) * 100);
  const octave = Math.floor((idx + 57) / 12) - 1;
  const name = NOTE_NAMES[((idx % 12) + 12) % 12];
  return { name: name + octave, cents, freq };
}

/* ---- Autocorrelation ---- */
function autoCorrelate(buf, sampleRate) {
  let SIZE = buf.length, rms = 0;
  for (let i = 0; i < SIZE; i++) rms += buf[i] * buf[i];
  rms = Math.sqrt(rms / SIZE);
  if (rms < 0.008) return -1;

  // Volume indicator
  const volPct = Math.min(100, rms * 800);
  document.getElementById('volFill').style.height = volPct + '%';

  let r1 = 0, r2 = SIZE - 1, thres = 0.2;
  for (let i = 0; i < SIZE / 2; i++) if (Math.abs(buf[i]) < thres) { r1 = i; break; }
  for (let i = 1; i < SIZE / 2; i++) if (Math.abs(buf[SIZE - i]) < thres) { r2 = SIZE - i; break; }

  buf = buf.slice(r1, r2); SIZE = buf.length;
  let c = new Array(SIZE).fill(0);
  for (let i = 0; i < SIZE; i++) {
    for (let j = 0; j < SIZE - i; j++) c[i] += buf[j] * buf[j + i];
  }

  let d = 0; while (c[d] > c[d + 1]) d++;
  let maxval = -1, maxpos = -1;
  for (let i = d; i < SIZE; i++) if (c[i] > maxval) { maxval = c[i]; maxpos = i; }

  let T0 = maxpos;
  // Parabolic interpolation
  if (T0 > 0 && T0 < SIZE - 1) {
    let x1 = c[T0 - 1], x2 = c[T0], x3 = c[T0 + 1];
    let a = (x1 + x3 - 2 * x2) / 2;
    let b = (x3 - x1) / 2;
    if (a) T0 = T0 - b / (2 * a);
  }
  return sampleRate / T0;
}

/* ========== CAMERA ========== */
async function setupCamera() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
    const mv = document.getElementById('mainVideo');
    const pv = document.getElementById('pipVideo');
    mv.srcObject = stream; pv.srcObject = stream;
    mv.style.display = 'block'; pv.style.display = 'block';
    document.getElementById('camPh').style.display = 'none';
    document.getElementById('pipPh').style.display = 'none';
  } catch (e) { console.log('Camera failed:', e); }
}

/* ========== AUDIO SETUP ========== */
async function setupAudio() {
  try {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const stream = await navigator.mediaDevices.getUserMedia({ audio: {
      echoCancellation: false, noiseSuppression: false, autoGainControl: false
    }});
    micStream = stream;
    const src = audioCtx.createMediaStreamSource(stream);
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 2048;
    analyser.smoothingTimeConstant = 0.85;
    src.connect(analyser);
    document.getElementById('status').textContent = '正在监听...';
  } catch (e) {
    console.log('Audio failed:', e);
    document.getElementById('status').textContent = '麦克风未授权 · 使用模拟模式';
  }
}

/* ========== MAIN LOOP ========== */
function update() {
  if (!analyser) { rafId = requestAnimationFrame(update); return; }

  const buffer = new Float32Array(analyser.fftSize);
  analyser.getFloatTimeDomainData(buffer);
  const freq = autoCorrelate(buffer, audioCtx.sampleRate);

  const noteName = document.getElementById('noteName');
  const noteFreq = document.getElementById('noteFreq');
  const needle = document.getElementById('needle');
  const centsBadge = document.getElementById('centsBadge');
  const status = document.getElementById('status');

  if (freq === -1) {
    noteName.textContent = '--';
    noteFreq.textContent = '等待演奏...';
    centsBadge.textContent = '';
    needle.style.bottom = '50%';
    status.textContent = '太安静了 · 请拉响琴';
    rafId = requestAnimationFrame(update);
    return;
  }

  const info = freqToNote(freq);
  let displayCents = info.cents;

  // If target string is selected, show deviation from target instead of nearest note
  if (targetFreq > 0) {
    displayCents = Math.round(1200 * Math.log2(freq / targetFreq));
    noteName.textContent = targetNote;
  } else {
    noteName.textContent = info.name;
  }

  const clamped = Math.max(-40, Math.min(40, displayCents));
  const pct = 50 + (clamped / 40) * 45;

  noteFreq.textContent = freq.toFixed(1) + ' Hz';
  needle.style.bottom = pct + '%';
  centsBadge.textContent = (displayCents > 0 ? '+' : '') + displayCents + '¢';

  // Color coding
  if (Math.abs(displayCents) <= 5) {
    needle.style.background = '#3fb950';
    needle.style.boxShadow = '0 0 16px rgba(63,185,80,0.6)';
    centsBadge.style.color = '#3fb950';
    status.textContent = '✓ 音准完美';
  } else if (Math.abs(displayCents) <= 15) {
    needle.style.background = '#d29922';
    needle.style.boxShadow = '0 0 12px rgba(210,153,34,0.4)';
    centsBadge.style.color = '#d29922';
    status.textContent = displayCents > 0 ? '↗ 稍微偏高' : '↘ 稍微偏低';
  } else {
    needle.style.background = '#f85149';
    needle.style.boxShadow = '0 0 12px rgba(248,81,73,0.4)';
    centsBadge.style.color = '#f85149';
    status.textContent = displayCents > 0 ? '↑ 音高偏高' : '↓ 音高偏低';
  }

  rafId = requestAnimationFrame(update);
}

/* ========== METRONOME ========== */
let metroInterval = null, metroOn = false;
function playClick(accent = false) {
  const ctx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.connect(gain); gain.connect(ctx.destination);
  osc.frequency.value = accent ? 1200 : 800;
  gain.gain.setValueAtTime(accent ? 0.35 : 0.2, ctx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.06);
  osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.06);
}
function toggleMetro() {
  metroOn = !metroOn;
  const btn = document.getElementById('metroBtn');
  if (metroOn) {
    btn.classList.add('on');
    const bpm = parseInt(document.getElementById('tempoSlider').value);
    let beat = 0;
    playClick(true); beat++;
    metroInterval = setInterval(() => {
      playClick(beat % 4 === 0);
      beat++;
    }, 60000 / bpm);
  } else {
    btn.classList.remove('on');
    clearInterval(metroInterval);
  }
}

/* ========== EVENTS ========== */
document.getElementById('startBtn').addEventListener('click', async () => {
  document.getElementById('startOverlay').classList.add('hidden');
  await setupAudio();
  await setupCamera();
  document.getElementById('recDot').style.display = 'block';
  isRunning = true;
  update();
});

document.getElementById('camPh').addEventListener('click', setupCamera);

document.querySelectorAll('.str-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.str-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    targetFreq = parseFloat(btn.dataset.freq);
    targetNote = btn.dataset.note;
  });
});

document.getElementById('metroBtn').addEventListener('click', toggleMetro);

document.getElementById('tempoSlider').addEventListener('input', function() {
  document.getElementById('tempoVal').textContent = this.value;
  if (metroOn) {
    clearInterval(metroInterval);
    const bpm = parseInt(this.value);
    let beat = 0;
    playClick(true); beat++;
    metroInterval = setInterval(() => { playClick(beat % 4 === 0); beat++; }, 60000 / bpm);
  }
});

let recording = false;
document.getElementById('recToggle').addEventListener('click', function() {
  recording = !recording;
  this.style.background = recording ? '#3fb950' : '#f85149';
  document.getElementById('recDot').style.display = recording ? 'block' : 'none';
});
</script>
</body>
</html>
